server {
	# Port dan upstream disuntik saat container start: Compose memakai default
	# dari Dockerfile, Render menyuntik PORT miliknya sendiri. NGINX_ENVSUBST_FILTER
	# membatasi substitusi pada dua variabel ini saja, sehingga $host dan $uri
	# milik Nginx tidak ikut tergantikan.
	listen ${PORT};
	server_name _;

	# Resolver diambil dari /etc/resolv.conf container oleh entrypoint Nginx.
	# Ini prasyarat untuk me-resolve upstream saat request, bukan saat start.
	resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

	root /usr/share/nginx/html;
	index index.html;

	# Jangan umumkan versi nginx yang dipakai.
	server_tokens off;

	# Bundle SPA dikirim mentah tanpa ini; kompresi memangkasnya sekitar dua pertiga.
	gzip on;
	gzip_vary on;
	gzip_comp_level 6;
	gzip_min_length 1024;
	gzip_proxied any;
	gzip_types
		text/plain
		text/css
		application/javascript
		application/json
		image/svg+xml
		font/woff2;

	# 'unsafe-inline' pada style diperlukan karena Tailwind v4 menyuntik elemen style saat runtime.
	add_header X-Content-Type-Options nosniff always;
	add_header X-Frame-Options DENY always;
	add_header Referrer-Policy strict-origin-when-cross-origin always;
	add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://upload.wikimedia.org; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

	# Aset ber-hash aman disimpan lama; index.html tidak boleh, atau pengguna
	# memegang SPA lama yang menunjuk hash yang sudah tidak ada.
	# add_header pada location bersarang membuang header dari server block,
	# sehingga header keamanan diulang di sini dengan sengaja.
	location /assets/ {
		expires 1y;
		add_header Cache-Control 'public, immutable' always;
		add_header X-Content-Type-Options nosniff always;
		add_header X-Frame-Options DENY always;
		add_header Referrer-Policy strict-origin-when-cross-origin always;
	}

	location = /index.html {
		add_header Cache-Control 'no-cache' always;
		add_header X-Content-Type-Options nosniff always;
		add_header X-Frame-Options DENY always;
		add_header Referrer-Policy strict-origin-when-cross-origin always;
		add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://upload.wikimedia.org; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
	}

	location /api/ {
		# Tanpa suffix URI, Nginx mempertahankan prefix /api milik kontrak backend.
		# Upstream sengaja melewati sebuah variabel. Dengan host literal, Nginx
		# me-resolve DNS sekali saat memuat konfigurasi dan menolak start kalau
		# nama itu belum ada -- persis yang terjadi ketika platform menyalakan
		# kedua service bersamaan dan API belum terdaftar. Lewat variabel,
		# resolusi terjadi per request: SPA tetap tersaji dan panggilan /api
		# membalas 502 sampai API siap, alih-alih container gagal hidup.
		#
		# API_ORIGIN memuat skema sekaligus host, karena tujuannya berbeda antar
		# lingkungan: Compose memakai http ke service tetangga, sedangkan Render
		# memakai https ke hostname publik API.
		set $api_origin ${API_ORIGIN};
		proxy_pass $api_origin;

		# Diperlukan saat upstream-nya https: tanpa SNI, TLS handshake ke
		# hostname bersama seperti *.onrender.com ditolak.
		proxy_ssl_server_name on;
		proxy_http_version 1.1;

		# Instance gratis Render tidur setelah 15 menit tanpa trafik dan butuh
		# sekitar satu menit untuk bangun. Tanpa timeout selonggar ini, request
		# pertama seorang reviewer berbalas 502 alih-alih menunggu API siap.
		proxy_connect_timeout 90s;
		proxy_send_timeout 90s;
		proxy_read_timeout 90s;
		# Host diisi host upstream, bukan host browser. Router Render memilih
		# service berdasarkan header ini, jadi meneruskan host frontend akan
		# mengarahkan request ke service yang salah.
		proxy_set_header Host $proxy_host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location / {
		try_files $uri $uri/ /index.html;
	}
}
